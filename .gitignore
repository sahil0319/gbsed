__pycache__/
*.py[cod]
*wandb/

# macOS / editor noise
.DS_Store

# GBSED <-> Veins working directories (regenerated by tools/gbsed_encode.py
# and tools/gbsed_decode.py; not source)
scene_data/
decoded/

# The full-image baseline payloads are verbatim copies of images_seq1/ (24 MB).
# Regenerate in seconds:
#   python tools/image_encode.py --meta scene_data_seq1 --images images_seq1 \
#       --mode full --out image_data_seq1_full
# The manifest and per-frame metadata ARE tracked -- they carry the measured
# sizes and chunk counts the analysis cites.
image_data_*_full/*.bin

# LaTeX build artefacts (both report/main.tex and the presentation deck)
report/*.aux
report/*.bbl
report/*.bcf
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.lof
report/*.log
report/*.lot
report/*.out
report/*.run.xml
report/*.toc
report/slides_figures/*.aux
report/slides_figures/*.bbl
report/slides_figures/*.bcf
report/slides_figures/*.blg
report/slides_figures/*.fdb_latexmk
report/slides_figures/*.fls
report/slides_figures/*.log
report/slides_figures/*.nav
report/slides_figures/*.out
report/slides_figures/*.pdf
report/slides_figures/*.run.xml
report/slides_figures/*.snm
report/slides_figures/*.synctex.gz
report/slides_figures/*.toc

# ad-hoc per-frame image dumps from `image_decode.py --save-images`,
